<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ─── Карточка ────────────────────────────────────────────────────── -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="Padding" Value="15" />
    </Style>

    <Style Selector="Border.inset">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ─── Кнопки ──────────────────────────────────────────────────────── -->

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Главное действие экрана: одно на весь экран, поэтому золотое -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#17130A" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,11" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrightBrush}" />
        <Setter Property="TextElement.Foreground" Value="#17130A" />
    </Style>

    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
        <Setter Property="TextElement.Foreground" Value="#8A8070" />
    </Style>

    <!-- Необратимое действие: приглушённый красный контур, не заливка -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerWashBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2E1815" />
        <Setter Property="TextElement.Foreground" Value="#E8735A" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.chip">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}" />
    </Style>

    <!--
        Баннер трекера. Кликается целиком, поэтому это кнопка, а не рамка:
        так работают и клавиатура, и фокус, и подсветка при наведении.
        Внутри вложенных кнопок быть не должно - клик достался бы обеим.
    -->
    <Style Selector="Button.banner">
        <Setter Property="Padding" Value="15,10" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#221C0F" Offset="0" />
                <GradientStop Color="#171410" Offset="0.6" />
                <GradientStop Color="#15130F" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <Style Selector="Button.banner /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.banner:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#2C2413" Offset="0" />
                <GradientStop Color="#1D1913" Offset="0.6" />
                <GradientStop Color="#1A1711" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <Style Selector="Button.banner:pressed /template/ ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1C1710" Offset="0" />
                <GradientStop Color="#15120E" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <!-- Адрес назначения справа: при наведении становится ярче вместе с рамкой -->
    <Style Selector="Button.banner:pointerover TextBlock.destination">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" />
    </Style>

    <!-- Ссылка наружу: открывается в браузере, поэтому и выглядит как ссылка -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>

    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrightBrush}" />
    </Style>

    <!-- Заголовок столбца: выглядит как подпись, ведёт себя как кнопка -->
    <Style Selector="Button.sort">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>

    <Style Selector="Button.sort:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrightBrush}" />
    </Style>

    <!-- Поле со стрелками: приводим к общему виду с остальными полями -->
    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ToggleButton не наследует стили Button, поэтому повторяем их здесь -->
    <Style Selector="ToggleButton.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ToggleButton.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ToggleButton.ghost:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrightBrush}" />
    </Style>

    <Style Selector="ToggleButton.ghost:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrightBrush}" />
    </Style>

    <!-- ─── Поля ввода ──────────────────────────────────────────────────── -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrightBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentDimBrush}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    </Style>

    <!-- ─── Списки ──────────────────────────────────────────────────────── -->

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ─── Разделитель ─────────────────────────────────────────────────── -->

    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="Margin" Value="0,14" />
    </Style>

</Styles>
