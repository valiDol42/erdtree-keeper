<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ErdtreeKeeper.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ErdtreeKeeper/Theme/Tokens.axaml" />
        <StyleInclude Source="avares://ErdtreeKeeper/Theme/Controls.axaml" />
    </Application.Styles>

</Application>
