<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ErdtreeKeeper.ViewModels"
        xmlns:core="using:ErdtreeKeeper.Core"
        x:Class="ErdtreeKeeper.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Erdtree Keeper"
        Width="1180" Height="900"
        MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Icon="avares://ErdtreeKeeper/Assets/erdtree-keeper.ico">

    <Panel>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,16,20,0">

            <!-- ─── Шапка ─────────────────────────────────────────────── -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Собственный знак: ветвь и хранилище. Ассетов игры в проекте нет. -->
                    <Canvas Width="30" Height="30">
                        <Path Fill="{DynamicResource AccentBrush}"
                              Data="M15 2 L17.6 8.4 L24 6.6 L20.2 12 L26 15 L20.2 18 L24 23.4 L17.6 21.6 L15 28 L12.4 21.6 L6 23.4 L9.8 18 L4 15 L9.8 12 L6 6.6 L12.4 8.4 Z" />
                        <Ellipse Canvas.Left="11" Canvas.Top="11" Width="8" Height="8"
                                 Fill="{DynamicResource AppBackground}" />
                    </Canvas>

                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Erdtree Keeper" Classes="title" />
                        <TextBlock Text="{Binding L[app.subtitle]}" Classes="muted" />
                    </StackPanel>
                </StackPanel>

                <!-- Отметка "не выходит в интернет" живёт в окне "Что программа
                     делает": там она стоит рядом с остальными обещаниями и
                     объяснением, как их проверить, а не висит без контекста. -->

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Переключатель языка: RU/EN без перезапуска -->
                    <ToggleButton Classes="ghost" Content="EN"
                                  ToolTip.Tip="{Binding L[app.language]}"
                                  IsChecked="{Binding IsEnglish}" />
                    <Button Classes="ghost" Content="{Binding L[app.whatItDoes]}" Click="OnShowTransparency" />
                    <Button Classes="ghost" Content="{Binding L[app.about]}" Click="OnShowAbout" />
                </StackPanel>
            </Grid>

            <!-- ─── Трекер ────────────────────────────────────────────── -->
            <!-- Числа берутся из того же справочника, которым программа
                 называет снимки: обещание подкреплено содержимым файла. -->
            <Button Grid.Row="1" Classes="banner" Margin="0,0,0,14"
                    ToolTip.Tip="{Binding L[tracker.openTip]}"
                    Click="OnOpenSite">

                <Grid ColumnDefinitions="Auto,*,Auto" >
                    <!-- Стилизованная карта с отмеченной точкой -->
                    <Canvas Grid.Column="0" Width="34" Height="34" VerticalAlignment="Center"
                            Margin="0,0,14,0">
                        <Path Fill="{DynamicResource AccentDimBrush}"
                              Data="M4 9 L14 5 L24 9 L34 5 L34 29 L24 33 L14 29 L4 33 Z" />
                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                              Data="M14 5 L14 29 M24 9 L24 33" />
                        <Ellipse Canvas.Left="16" Canvas.Top="14" Width="10" Height="10"
                                 Fill="{DynamicResource AccentBrightBrush}" />
                        <Ellipse Canvas.Left="19" Canvas.Top="17" Width="4" Height="4"
                                 Fill="#15130F" />
                    </Canvas>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Erdtree Compass" Classes="title accent" />
                            <TextBlock Text="{Binding L[tracker.tagline]}" Classes="secondary"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding L[tracker.safe]}" Classes="secondary"
                                       Foreground="{DynamicResource FreshBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding TrackerPitch}" Classes="muted" />
                    </StackPanel>

                    <!-- Куда ведёт клик - видно до клика. Прятать назначение
                         ссылки в приложении про доверие было бы странно. -->
                    <TextBlock Grid.Column="2" Classes="secondary destination"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="14,0,2,0"
                               Text="eldenring.krut.top  ↗" />
                </Grid>
            </Button>

            <!-- ─── Рабочая область ───────────────────────────────────── -->
            <Grid Grid.Row="2" ColumnDefinitions="420,20,*">

                <!-- ── Левая колонка ── -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <!-- Откуда -->
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding L[source.section]}" Classes="section" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding L[source.account]}" Classes="secondary" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding Accounts}"
                                                  SelectedItem="{Binding SelectedAccount}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AccountItem">
                                                    <TextBlock Text="{Binding Display}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="{Binding L[source.rename]}"
                                                Command="{Binding RenameAccountCommand}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding L[source.file]}" Classes="secondary" />
                                    <ComboBox ItemsSource="{Binding SaveFiles}"
                                              SelectedItem="{Binding SelectedSaveFile}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:SaveFile">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Свежесть сейва: главный индикатор экрана.
                                     Игра пишет файл с задержкой, и копия, снятая
                                     раньше записи, не содержит последних событий. -->
                                <Border CornerRadius="{DynamicResource RadiusMedium}"
                                        Background="{Binding FreshnessWash}"
                                        BorderBrush="{Binding FreshnessBrush}"
                                        BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding FreshnessBrush}" />
                                            <TextBlock Text="{Binding FreshnessText}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding FreshnessBrush}" />
                                        </StackPanel>
</StackPanel>
                                </Border>

                                <!-- Блок кликается целиком и открывает карточку
                                     игрока: всё, что удалось прочитать из сейва. -->
                                <Button Classes="block" IsEnabled="{Binding HasContext}"
                                        ToolTip.Tip="{Binding L[source.playerCardTip]}"
                                        Click="OnShowPlayerCard">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="{Binding CharacterLine}" Classes="body" />
                                            <TextBlock Text="{Binding PlaceLine}" Classes="secondary"
                                                       IsVisible="{Binding HasContext}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="›" FontSize="20"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   IsVisible="{Binding HasContext}" />
                                    </Grid>
                                </Button>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Grid.Column="0" Content="{Binding L[source.read]}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding AnalyzeCommand}" />
                                    <Button Grid.Column="1" Content="{Binding L[source.checkIntegrity]}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding CheckIntegrityCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Имя снимка -->
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding L[name.section]}" Classes="section" />

                                <TextBox Text="{Binding SnapshotName}"
                                         PlaceholderText="{Binding L[name.placeholder]}" />

                                <!-- Имя набирается кнопками: так написание одного
                                     и того же места не расходится между файлами. -->
                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                    <Button Classes="chip" Content="{Binding L[name.addLocation]}"
                                            ToolTip.Tip="{Binding L[name.addLocationTip]}"
                                            Command="{Binding AddLocationCommand}" />
                                    <Button Classes="chip" Content="{Binding L[name.addBoss]}"
                                            ToolTip.Tip="{Binding L[name.addBossTip]}"
                                            Command="{Binding AddBossCommand}" />
                                    <Button Classes="chip" Content="{Binding L[name.addBefore]}"
                                            Command="{Binding AddBeforeCommand}" />
                                    <Button Classes="chip" Content="{Binding L[name.addAfter]}"
                                            Command="{Binding AddAfterCommand}" />
                                    <Button Classes="chip" Content="{Binding L[name.clear]}"
                                            Command="{Binding ClearNameCommand}" />
                                </WrapPanel>

                                <!-- Одна строка с многоточием: длинное имя иначе переносится и
                                     выталкивает настройки автосохранения за край окна. -->
                                <TextBlock Text="{Binding SnapshotPreview}" Classes="muted"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding SnapshotPreview}" />

                                <Button Classes="primary" Content="{Binding L[name.take]}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding CreateSnapshotCommand}" />

                                <!-- Настройки живут в отдельном окне: на главном
                                     экране им не хватало высоты, и строка с папкой
                                     уезжала за край при невысоком окне. -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <CheckBox Grid.Column="0" Content="{Binding L[auto.enable]}"
                                              ToolTip.Tip="{Binding L[auto.enableTip]}"
                                              IsChecked="{Binding AutoSnapshotEnabled}" />
                                    <Button Grid.Column="1" Classes="chip" Content="{Binding L[auto.configure]}"
                                            IsEnabled="{Binding AutoSnapshotEnabled}"
                                            Click="OnShowAutoSaveSettings" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Правая колонка ── -->
                <!-- Журнал живёт здесь, а не внизу окна: снизу он отбирал высоту
                     у левой колонки, и кнопка "Сделать снимок" уходила под срез. -->
                <Grid Grid.Column="2" RowDefinitions="*,Auto">

                <Border Grid.Row="0" Classes="card">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" >

                        <!-- Переключатель папки стоит над списком, а не отдельной
                             вкладкой: кнопки под списком работают с тем, что видно. -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                            <ComboBox Grid.Column="0" Width="190"
                                      ItemsSource="{Binding SnapshotSources}"
                                      SelectedIndex="{Binding SnapshotSourceIndex}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button Classes="chip" Content="{Binding L[app.browse]}" Command="{Binding PickFolderCommand}" />
                                <Button Classes="chip" Content="{Binding L[app.openFolder]}" Command="{Binding OpenSnapshotFolderCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding ListFolder}" Classes="muted"
                                   Margin="0,0,0,12" TextTrimming="CharacterEllipsis" />

                        <Border Grid.Row="2" Classes="inset" Padding="8">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Заголовки сортируют список; повторный щелчок по
                                     тому же столбцу переворачивает порядок, как в
                                     проводнике - объяснять это не приходится. -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,2,4,6">
                                    <Button Grid.Column="0" Classes="sort" HorizontalAlignment="Left"
                                            Content="{Binding NameSortLabel}"
                                            Command="{Binding SortByNameCommand}" />
                                    <Button Grid.Column="1" Classes="sort"
                                            Content="{Binding DateSortLabel}"
                                            Command="{Binding SortByDateCommand}" />
                                </Grid>

                                <Panel Grid.Row="1">
                                <!-- Multiple,Toggle: щелчок добавляет и снимает
                                     выбор без Ctrl - иначе массовые операции
                                     доступны только тем, кто знает про Ctrl. -->
                                <ListBox Name="SnapshotList"
                                         ItemsSource="{Binding Snapshots}"
                                         SelectionMode="Multiple,Toggle">
                                    <ListBox.Styles>
                                        <!-- Выбор принадлежит строке, а не списку:
                                             так он переживает обновление и виден
                                             модели без обращения к элементам управления. -->
                                        <Style Selector="ListBoxItem" x:DataType="vm:SnapshotRow">
                                            <Setter Property="IsSelected"
                                                    Value="{Binding IsSelected, Mode=TwoWay}" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SnapshotRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Grid.Column="0" Classes="tick" VerticalAlignment="Center">
                                                    <Path Classes="tickmark" Fill="#17130A"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M1,4 L3.4,6.6 L9,0.6 L10.4,2 L3.4,9.4 L-0.4,5.4 Z" />
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Classes="snapshot-name"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14">
                                                    <TextBlock Text="{Binding SizeText}" Classes="muted"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Created, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                               Classes="muted" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Пустое состояние объясняет, что делать дальше -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Spacing="6" MaxWidth="380"
                                            IsVisible="{Binding !Snapshots.Count}">
                                    <TextBlock Text="{Binding L[list.empty]}" Classes="body"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Classes="muted" TextAlignment="Center"
                                               Text="{Binding EmptyStateHint}" />
                                </StackPanel>
                                </Panel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3" Spacing="10" Margin="0,12,0,0">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <Button Grid.Column="0" Classes="chip" Content="{Binding L[list.selectAll]}"
                                        Margin="0,0,6,0" Command="{Binding SelectAllCommand}" />
                                <Button Grid.Column="1" Classes="chip" Content="{Binding L[list.clearSelection]}"
                                        Command="{Binding ClearSelectionCommand}" />
                                <!-- Сколько файлов затронет следующая операция -->
                                <TextBlock Grid.Column="2" Text="{Binding SelectionSummary}"
                                           Classes="muted" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                <Button Grid.Column="0" Content="{Binding L[list.rename]}"
                                        ToolTip.Tip="{Binding L[list.oneOnlyTip]}"
                                        Command="{Binding RenameCommand}" />
                                <Button Grid.Column="1" Content="{Binding DeleteLabel}"
                                        Command="{Binding DeleteCommand}" />
                                <!-- Необратимое действие стоит поодаль от остальных -->
                                <Button Grid.Column="3" Classes="danger" Content="{Binding L[list.restore]}"
                                        ToolTip.Tip="{Binding L[list.oneOnlyTip]}"
                                        Command="{Binding RestoreCommand}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Журнал: полный список того, что программа трогала на диске -->
                <Border Grid.Row="1" Classes="card" Margin="0,16,0,0" Padding="15,12"
                        IsVisible="{Binding #LogToggle.IsChecked}">
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                            <TextBlock Grid.Column="0" Text="{Binding L[log.section]}" Classes="section"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="chip" Content="{Binding L[log.export]}"
                                    Command="{Binding ExportLogCommand}" />
                            <!-- Закрыть можно и здесь, и переключателем внизу окна:
                                 искать способ убрать журнал не должно приходиться. -->
                            <Button Grid.Column="2" Classes="ghost" Content="✕" Margin="6,0,0,0"
                                    ToolTip.Tip="{Binding L[log.hide]}"
                                    Click="OnHideLog" />
                        </Grid>

                        <Border Grid.Row="1" Classes="inset" Height="170" Padding="10,8">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Log.Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:ActivityEntry">
                                            <TextBlock Text="{Binding Line}" Classes="mono"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,0,3" TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
                </Grid>
            </Grid>

            <!-- ─── Низ: статус и подпись ─────────────────────────────── -->
            <StackPanel Grid.Row="3" Margin="0,14,0,12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="13"
                               Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <ToggleButton Grid.Column="1" Name="LogToggle" Classes="ghost"
                                  Content="{Binding L[log.toggle]}" />
                </Grid>

                <Border Classes="divider" Margin="0,10,0,6" />

                <!-- Версия со сборкой: две сборки одной версии иначе не отличить -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FooterText}" Classes="muted"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·" Classes="muted" VerticalAlignment="Center" />
                    <Button Classes="link" Content="krut.top" Padding="0,2"
                            ToolTip.Tip="{Binding L[foot.siteTip]}"
                            Click="OnOpenHome" />
                    <TextBlock Text="·" Classes="muted" VerticalAlignment="Center" />
                    <!-- Почта для связи: по ней же присылают вопросы про безопасность -->
                    <Button Classes="link" Content="admin@krut.top" Padding="0,2"
                            ToolTip.Tip="{Binding L[foot.mailTip]}"
                            Click="OnOpenEmail" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ─── Первый запуск ─────────────────────────────────────────── -->
        <Border IsVisible="{Binding ShowOnboarding}" Background="#D0000000">
            <Border Classes="card" MaxWidth="640" Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding L[onboard.title]}" Classes="display" />

                    <TextBlock Classes="body" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding L[onboard.lead]}" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding L[onboard.madeBy]}" Classes="secondary"
                                   VerticalAlignment="Center" />
                        <Button Classes="link" Content="eldenring.krut.top" Click="OnOpenSite" />
                    </StackPanel>

                    <StackPanel Spacing="9">
                        <TextBlock Text="{Binding L[onboard.does]}" Classes="section" />
                        <TextBlock Classes="secondary" Text="{Binding L[onboard.does1]}" />
                        <TextBlock Classes="secondary" Text="{Binding L[onboard.does2]}" />
                        <TextBlock Classes="secondary" Text="{Binding L[onboard.does3]}" />
                    </StackPanel>

                    <StackPanel Spacing="9">
                        <TextBlock Text="{Binding L[onboard.doesNot]}" Classes="section" />
                        <TextBlock Classes="secondary" Text="{Binding L[onboard.not1]}" />
                        <TextBlock Classes="secondary" Text="{Binding L[onboard.not2]}" />
                        <TextBlock Classes="secondary" Text="{Binding L[onboard.not3]}" />
                        <TextBlock Classes="secondary" Text="{Binding L[onboard.not4]}" />
                    </StackPanel>

                    <Border Classes="inset" Background="{DynamicResource WarnWashBrush}"
                            BorderBrush="{DynamicResource WarnBrush}">
                        <TextBlock Classes="secondary" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding L[onboard.warning]}" />
                    </Border>

                    <Button Classes="primary" Content="{Binding L[onboard.ok]}" HorizontalAlignment="Right"
                            Command="{Binding DismissOnboardingCommand}" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
